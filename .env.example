# LLM provider. Default is OpenAI; "groq" and "gemini" are also wired up and can be
# reactivated by switching this and filling in that provider's key below.
LLM_PROVIDER=openai

# OpenAI API key (https://platform.openai.com/api-keys) -- the default provider.
OPENAI_API_KEY=
# Generation model (default: gpt-4o-mini, the cheap well-established mini tier).
OPENAI_MODEL=gpt-4o-mini

# --- Alternative providers (optional; only needed if you set LLM_PROVIDER above) ---
# Groq (https://console.groq.com) -- retained but dormant; fastest/cheapest per token.
GROQ_API_KEY=
# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Admin-panel accounts are not configured here — see backend/users.json, managed via
# `python scripts/manage_users.py add <username> admin` (run locally, e.g. from the IDE).

# Embedding device: "cuda" (default) or "cpu" fallback
EMBEDDING_DEVICE=cuda

# Reranker device: "cuda" (default, fp16) or "cpu" fallback
RERANKER_DEVICE=cuda

# --- docker-compose.prod.yml only (public deployment) ---
# Public hostname Caddy should request a Let's Encrypt cert for, e.g. a real domain/subdomain
# or a free sslip.io hostname for your VPS's IP (e.g. 203.0.113.10.sslip.io).
# Leave unset (or ":80") to just serve plain HTTP with no TLS, e.g. for a quick local test.
DOMAIN=
