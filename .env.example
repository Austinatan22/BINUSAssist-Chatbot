# Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Admin-panel accounts are not configured here — see backend/users.json, managed via
# `python scripts/manage_users.py add <username> admin` (run locally, e.g. from the IDE).

# Embedding device: "cuda" (default) or "cpu" fallback
EMBEDDING_DEVICE=cuda

# Reranker device: "cuda" (default, fp16) or "cpu" fallback
RERANKER_DEVICE=cuda

# --- docker-compose.prod.yml only (public deployment) ---
# Public hostname Caddy should request a Let's Encrypt cert for, e.g. a real domain/subdomain
# or a free sslip.io hostname for your VPS's IP (e.g. 203.0.113.10.sslip.io).
# Leave unset (or ":80") to just serve plain HTTP with no TLS, e.g. for a quick local test.
DOMAIN=
